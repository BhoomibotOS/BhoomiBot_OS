# .aiexclude - Restricts AI access to specific files and directories

# IDE and Build directories
.idea/
.gradle/
**/build/
captures/

# Credentials and sensitive config
local.properties
*.keystore
*.jks
google-services.json

# Add specific files you want to restrict here
# Example:
# app/src/main/java/com/bhoomibot/os/vcu/ConnectionPreferences.kt
